# An armed NPC that can be controlled or placed on a map patrol route.
battalion-entity 1
id beam-soldier
display-name Beam Soldier
description Armed infantry actor with patrol, sensor, and trigger components.
editor-category npcs
editor-color blue
wreck-fire-projectile projectile-flame
destruction-projectile projectile-debris
destruction-effect explosion-standard
destruction-sound crash
destruction-debris-count 7
destruction-fire-count 3
destruction-effect-count 1
debris-life 420
impact-projectile projectile-scar
kind npc
collision-footprint model
controllable yes
control-mode free
model hero-beam
muzzle-node muzzle
idle-animation hero-beam-walk
move-animation hero-beam-walk
attack-animation hero-beam-fire
animation-speed 0.05
faction army
movement ground
speed 0.03
turn-rate 0.2
health 4
score 15
scale 1
vertical-offset 1
collision-radius 0.2
collision-height 0.9
weapon beam
fire-sound beam
weapon-color red
weapon-core-color white
weapon-trace-color black
weapon-damage 1
weapon-damages-actors yes
weapon-destroys-map-objects yes
weapon-range 5
weapon-min-range 0.25
projectile-speed 0.1
fire-interval 1
accuracy 20
forget-range 12
lost-frames 180
target-mode nearest
max-targets 1
sensor nearby proximity 1.5 360 hostile
sensor sight vision 8 100 hostile
sensor noise hearing 10 360 hostile
sensor damaged damage 0 360 hostile
on-enter nearby attack squad-alert
on-enter sight attack squad-alert
on-enter noise investigate squad-alert
on-enter damaged attack squad-alert
on-trigger squad-alert activate none
on-trigger squad-alert attack none
spawn-weight 0
spawn-after 0
max-active 0
player-energy 50
player-height 0.9
player-width 0.2
player-bottom 0
player-regen 0.1
player-move-cost 0.05
player-fire-cost 0.05
player-turn-rate 35
player-steer-rate 18
aim-pitch-default 0
aim-pitch-min -40
aim-pitch-max 40
first-person-eye-height 1.75
first-person-visible no
view-1-height-fraction 0.34
view-2-height-fraction 0.25
