# A controllable helicopter using the same generic entity runtime.
battalion-entity 1
id helo-standard
display-name Helicopter
kind vehicle
controllable yes
control-mode free
model helo
model-yaw-offset 180
muzzle-node muzzle
idle-animation helo-rotors
move-animation helo-rotors
attack-animation helo-rotors
animation-speed 0.05
faction army
hostile-faction monster
movement air
speed 0.045
turn-rate 0.2
health 2
score 8
scale 1
vertical-offset 1
collision-radius 0.3
collision-height 0.4
weapon rocket
weapon-color white
weapon-range 6
weapon-min-range 0.5
projectile-speed 0.1
fire-interval 90
accuracy 1000
forget-range 14
lost-frames 180
target-mode nearest
max-targets 1
sensor sight vision 10 140 hostile
sensor noise hearing 14 360 hostile
sensor damaged damage 0 360 hostile
on-enter sight attack air-alert
on-enter noise investigate air-alert
on-enter damaged attack air-alert
on-trigger air-alert activate none
on-trigger air-alert attack none
spawn-weight 17
spawn-after 0
max-active 0
player-energy 50
player-height 1.4
player-width 0.3
player-bottom 1
player-regen 0.1
player-move-cost 0.06
player-fire-cost 0.06
player-turn-rate 40
player-steer-rate 18
aim-pitch-default 0
aim-pitch-min -40
aim-pitch-max 40
first-person-eye-height 1.3
first-person-visible no
view-1-height-fraction 0.34
view-2-height-fraction 0.25
