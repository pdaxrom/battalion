# A generic guard/patrol tank. Maps provide instances and patrol paths.
battalion-entity 1
id tank-standard
display-name Standard Tank
description Generic guard and patrol tank using the catalog shell projectile.
property callsign string none
editor-category vehicles
editor-color yellow
wreck-fire-projectile projectile-flame
destruction-projectile projectile-debris
destruction-effect explosion-standard
destruction-sound crash
destruction-debris-count 7
destruction-fire-count 3
destruction-effect-count 1
debris-life 420
kind vehicle
collision-footprint model
move-sound engine-rumble
move-sound-interval 18
contact-audio-tag tracked
controllable yes
control-mode steered
model tank
move-animation tank-tracks
animation-speed 0.05
aim-yaw-node turret
aim-pitch-node barrel
muzzle-node muzzle
faction army
movement ground
speed 0.03
turn-rate 0.2
health 2
score 10
scale 1
vertical-offset 0
collision-radius 0.25
collision-height 0.3
weapon projectile
projectile projectile-shell
fire-sound tank
weapon-color white
weapon-range 6
weapon-min-range 0.5
projectile-speed 0.3
fire-interval 120
accuracy 1000
forget-range 60
lost-frames 1200
target-mode all
max-targets 4
sensor nearby proximity 2 360 hostile
sensor sight vision 8 120 hostile
sensor noise hearing 12 360 hostile
sensor damaged damage 0 360 hostile
on-enter nearby attack base-alarm
on-enter sight attack base-alarm
on-enter noise investigate base-alarm
on-enter damaged attack base-alarm
on-trigger base-alarm activate none
on-trigger base-alarm investigate none
on-trigger spawned pursue none
spawn-weight 20
spawn-after 0
max-active 0
player-energy 50
player-height 0.6
player-width 0.3
player-bottom 0
player-regen 0.1
player-move-cost 0.05
player-fire-cost 0.05
player-turn-rate 35
player-steer-rate 8
aim-pitch-default 0
aim-pitch-min -20
aim-pitch-max 35
first-person-eye-height 0.28
first-person-visible no
view-1-height-fraction 0.34
view-2-height-fraction 0.25
