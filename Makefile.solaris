#
# Makefile for the Solaris version of battalion 1.3
# (to produce Mesa + OpenGL + TGS binaries)
#
# 9-July-96
#
# Now possible to build a battalion binary "battalion.tgs" using the
# TGS (Template Graphics Software) implementation of OpenGL for ZX.
#

#--------------- Solaris battalion 1.2 --------------------
#
# Native Solaris make companion. The normal cross-platform entry point is
# `gmake PLATFORM=solaris`; this file exists for systems with Sun make only.

PROGRAM = battalion
CC = cc
PLATFORM = solaris
GRAPHICS = opengl
AUDIO = sun
AUDIO_SMOOTHING = 1
BUILD_DIR = build/$(PLATFORM)-$(GRAPHICS)-$(AUDIO)
TARGET = $(BUILD_DIR)/$(PROGRAM)

CPPFLAGS =
PLATFORM_CPPFLAGS = -DSOLARIS -I/usr/openwin/include
AUDIO_CPPFLAGS = -DSPATIALAUDIO -DAUDIO_SMOOTHING_DEFAULT=$(AUDIO_SMOOTHING)
COMPAT_CFLAGS = -Xa
CFLAGS = -O2
LDFLAGS =
LDLIBS = -L/usr/openwin/lib -lGL -lGLU -lXext -lX11 -lnsl -lsocket \
	-lm -lpthread

SOURCES = battalion.c map.c net.c graphics.c camera.c camera_view.c \
	text.c update.c tk_x11.c font.c dynamic_primitives.c map_package.c \
	asset.c asset_gltf.c asset_animation.c asset_skin.c asset_render.c \
	asset_manifest.c asset_bindings.c asset_tga.c asset_values.c \
	stroke_font_asset.c asset_png.c audio_catalog.c entity_catalog.c \
	entity_behavior.c world_coordinates.c audio_spatial.c audio_mixer.c \
	audio_backend_sun.c

OBJECTS = $(BUILD_DIR)/battalion.o $(BUILD_DIR)/map.o \
	$(BUILD_DIR)/net.o $(BUILD_DIR)/graphics.o \
	$(BUILD_DIR)/camera.o $(BUILD_DIR)/camera_view.o \
	$(BUILD_DIR)/text.o $(BUILD_DIR)/update.o \
	$(BUILD_DIR)/tk_x11.o $(BUILD_DIR)/font.o \
	$(BUILD_DIR)/dynamic_primitives.o $(BUILD_DIR)/map_package.o \
	$(BUILD_DIR)/asset.o $(BUILD_DIR)/asset_gltf.o \
	$(BUILD_DIR)/asset_animation.o $(BUILD_DIR)/asset_skin.o \
	$(BUILD_DIR)/asset_render.o $(BUILD_DIR)/asset_manifest.o \
	$(BUILD_DIR)/asset_bindings.o $(BUILD_DIR)/asset_tga.o \
	$(BUILD_DIR)/asset_values.o $(BUILD_DIR)/stroke_font_asset.o \
	$(BUILD_DIR)/asset_png.o $(BUILD_DIR)/audio_catalog.o \
	$(BUILD_DIR)/entity_catalog.o $(BUILD_DIR)/entity_behavior.o \
	$(BUILD_DIR)/world_coordinates.o $(BUILD_DIR)/audio_spatial.o \
	$(BUILD_DIR)/audio_mixer.o $(BUILD_DIR)/audio_backend_sun.o

HEADERS = battalion.h tk.h map.h map_package.h camera_view.h asset.h \
	asset_animation.h asset_skin.h asset_render.h asset_manifest.h \
	asset_bindings.h asset_tga.h asset_values.h asset_png.h \
	stroke_font_asset.h audio_catalog.h audio_backend.h audio_mixer.h \
	entity_catalog.h entity_behavior.h dynamic_primitives.h \
	world_coordinates.h

all: $(TARGET)

$(TARGET): FORCE $(SOURCES) $(HEADERS) Makefile.solaris
	@if test ! -d "$(BUILD_DIR)"; then mkdir -p "$(BUILD_DIR)"; fi
	@for source in $(SOURCES); do \
		base=`basename "$$source" .c`; \
		object="$(BUILD_DIR)/$$base.o"; \
		echo "$(CC) $(CPPFLAGS) $(PLATFORM_CPPFLAGS) $(AUDIO_CPPFLAGS) $(COMPAT_CFLAGS) $(CFLAGS) -c $$source -o $$object"; \
		$(CC) $(CPPFLAGS) $(PLATFORM_CPPFLAGS) $(AUDIO_CPPFLAGS) $(COMPAT_CFLAGS) $(CFLAGS) -c "$$source" -o "$$object" || exit 1; \
	done
	$(CC) $(LDFLAGS) -o $(TARGET) $(OBJECTS) $(LDLIBS)

print-config:
	@echo "platform:   $(PLATFORM)"
	@echo "graphics:   $(GRAPHICS)"
	@echo "audio:      $(AUDIO)"
	@echo "smoothing:  $(AUDIO_SMOOTHING)"
	@echo "compiler:   $(CC)"
	@echo "output:     $(TARGET)"

help:
	@echo "Usage: make -f Makefile.solaris [AUDIO_SMOOTHING=0|1]"
	@echo "Builds native OpenGL and positional stereo through /dev/audio."

FORCE:

clean:
	rm -f $(OBJECTS) $(TARGET)
