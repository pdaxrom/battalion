#!/bin/sh

# SGI make delegates here through the first line of the main Makefile.
# Keep configuration selection in this small POSIX shell wrapper because
# IRIX 6.x make does not understand GNU make conditionals or functions.

platform=sgi
graphics=opengl
audio=sgi
audio_smoothing=1

for argument in "$@"
do
    case "$argument" in
        PLATFORM=*) platform=`expr "x$argument" : 'xPLATFORM=\(.*\)'` ;;
        GRAPHICS=*) graphics=`expr "x$argument" : 'xGRAPHICS=\(.*\)'` ;;
        AUDIO=*) audio=`expr "x$argument" : 'xAUDIO=\(.*\)'` ;;
        AUDIO_SMOOTHING=*) audio_smoothing=`expr "x$argument" : 'xAUDIO_SMOOTHING=\(.*\)'` ;;
    esac
done

case "$platform" in
    sgi) ;;
    irix) ;;
    *)
        echo "IRIX build supports PLATFORM=sgi (or PLATFORM=irix)" >&2
        exit 2
        ;;
esac

case "$audio_smoothing" in
    0) ;;
    1) ;;
    *)
        echo "IRIX build supports AUDIO_SMOOTHING=0 or AUDIO_SMOOTHING=1" >&2
        exit 2
        ;;
esac

case "$graphics" in
    opengl) ;;
    mesa)
        set -- "$@" GRAPHICS_CPPFLAGS=-DMESAVERSION
        set -- "$@" "PLATFORM_LDLIBS=-lMesaGL -lMesaGLU -lX11 -lXext -lm"
        ;;
    *)
        echo "IRIX build supports GRAPHICS=opengl or GRAPHICS=mesa" >&2
        exit 2
        ;;
esac

case "$audio" in
    none)
        audio_objects="build/$platform-$graphics-$audio/audio.o"
        set -- "$@" AUDIO_SOURCES=audio.c
        set -- "$@" "AUDIO_OBJECTS=$audio_objects"
        set -- "$@" AUDIO_CPPFLAGS=
        set -- "$@" AUDIO_LDLIBS=
        ;;
    sgi)
        audio_objects="build/$platform-$graphics-$audio/audio_spatial.o build/$platform-$graphics-$audio/audio_mixer.o build/$platform-$graphics-$audio/audio_backend_sgi.o"
        if test "$audio_smoothing" = 0
        then
            audio_objects="build/$platform-$graphics-$audio-nosmooth/audio_spatial.o build/$platform-$graphics-$audio-nosmooth/audio_mixer.o build/$platform-$graphics-$audio-nosmooth/audio_backend_sgi.o"
            set -- "$@" "BUILD_DIR=build/$platform-$graphics-$audio-nosmooth"
        fi
        set -- "$@" "AUDIO_SOURCES=audio_spatial.c audio_mixer.c audio_backend_sgi.c"
        set -- "$@" "AUDIO_OBJECTS=$audio_objects"
        set -- "$@" "AUDIO_CPPFLAGS=-DSPATIALAUDIO -DAUDIO_SMOOTHING_DEFAULT=$audio_smoothing"
        set -- "$@" "AUDIO_LDLIBS=-laudio -lpthread"
        ;;
    *)
        echo "IRIX build supports AUDIO=none or AUDIO=sgi" >&2
        exit 2
        ;;
esac

exec /usr/bin/make "$@"
